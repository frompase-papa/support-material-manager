# 学習記録の受信API 用の環境変数。
# ローカルでは .env.local にコピーして値を設定。本番は Vercel の Environment Variables に設定。
# （このファイルは例。実際の秘密値はコミットしないこと＝.env.local はGit管理外）

# 拡張機能と共有する合言葉（任意の長いランダム文字列）。拡張の background.js の API_KEY と同じ値にする。
STUDY_API_KEY=

# Firebase サービスアカウントの秘密鍵JSON（1行の文字列として貼り付け）。
# 取得：Firebaseコンソール → プロジェクトの設定 → サービスアカウント → 「新しい秘密鍵の生成」→ ダウンロードしたJSONの中身。
# 例（1行）: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...", ...}
FIREBASE_SERVICE_ACCOUNT=
